# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# hydra run dirs
outputs/
multirun/

# weights, checkpoints, datasets, results — tracked in W&B, not git
*.pt
*.bin
*.safetensors
checkpoints/
results/*
!results/.gitkeep

# local secrets / env
.env
wandb/

# slurm job output and local HF cache
slurm/logs/*
!slurm/logs/.gitkeep
.cache/

