# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# hydra run dirs
outputs/
multirun/

# weights, checkpoints, datasets, results — tracked in W&B, not git
*.pt
*.bin
*.safetensors
checkpoints/
results/*
!results/.gitkeep

# local secrets / env
.env
wandb/

# slurm job output — .out logs ARE tracked (small plain text, and the
# notebooks/results_analysis.ipynb source of truth for phase 3 reads them
# directly); .err logs are excluded (httpx/progress-bar debug noise, not
# needed by anything in the repo)
slurm/logs/*
!slurm/logs/.gitkeep
!slurm/logs/*.out

# local HF cache
.cache/

# operational bookkeeping edited directly on the cluster (sed'd in place
# between job submissions) — not experiment code, must never make the
# working tree "dirty" and trip get_git_sha()'s uncommitted-changes guard
slurm/phase3_queue.txt

